# PostgreSQL (default). For a quick local run without Postgres use:
# DATABASE_URL=sqlite:///./resume_screening.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_screening
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=uploads/resumes
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to "lexical" to skip downloading the sentence-transformers model
NLP_BACKEND=
